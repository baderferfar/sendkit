{
  "name": "sendkit-workspace",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "build:core": "bun run --filter @ferfarbader/sendkit-core build",
    "build:cli": "bun run --filter @ferfarbader/sendkit build",
    "build:local-mcp": "bun run --filter @ferfarbader/sendkit-mcp build",
    "release:pack:core": "bun run --filter @ferfarbader/sendkit-core pack:dry",
    "release:pack:cli": "bun run --filter @ferfarbader/sendkit pack:dry",
    "release:pack:local-mcp": "bun run --filter @ferfarbader/sendkit-mcp pack:dry",
    "dev:cli": "bun run packages/cli/src/index.ts",
    "dev:local-mcp": "bun run packages/local-mcp/src/index.ts",
    "dev:remote-mcp": "bun run apps/remote-mcp/src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0"
  }
}
